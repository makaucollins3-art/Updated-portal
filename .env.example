# Copy this file to .env and fill it in. Never commit .env or share the service key.

# Supabase > Project Settings > API
#SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "service_role" key (or the new "secret" key). Server only. Full access to your data.
#SUPABASE_SERVICE_KEY=
# "anon" key (or the new "publishable" key). Used only for sign-up, sign-in and reset emails.
#SUPABASE_ANON_KEY=

# Public address of the portal. Used in the links inside emails.
#PUBLIC_URL=http://localhost:3000
# The portal always runs on port 3000 (fixed in server.js); PORT is ignored.
# Set to 1 when the portal sits behind Caddy or Nginx
#TRUST_PROXY=
#NCBA_ACCOUNT_NO=

# ---- Email (SMTP): sends the sign-up confirmation and password-reset emails. Required for online sign-up.
# Any provider works: Brevo, Resend, Mailgun, Gmail (app password), or your hosting company's mail server.
#SMTP_HOST=smtp-relay.brevo.com
# 587 = STARTTLS (most providers). 465 = TLS from the first byte (turned on automatically).
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
# The "From" address. Use an address or domain your provider has verified, or messages will be rejected or go to spam.
#MAIL_FROM=IFT Portal <no-reply@yourdomain.co.ke>
# Only on a test computer with no SMTP: print emails in the log instead of sending them (members get nothing).
#MAIL_DEV=1
# Check your settings any time with:  node test-mail.js you@example.com
