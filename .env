#SUPABASE_ANON_KEY=

# Public address of the portal. Used in email links, so it must match Supabase > Authentication > URL Configuration.
#PUBLIC_URL=http://localhost:3000
#PORT=3000
# Set to 1 when the portal sits behind Caddy or Nginx
#TRUST_PROXY=
#NCBA_ACCOUNT_NO=
